[Unit]
Description=MQTT Telldus Client systemd demon

[Service]
WorkingDirectory=/usr/local/bin/telldusmqtt
ExecStart=/usr/local/bin/telldusmqtt/telldusmqtt
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=telldusmqtt
Environment=NETCORE_ENVIRONMENT=Production

[Install]
WantedBy=multi-user.target